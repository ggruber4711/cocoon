<!--
  - Root sitemap for the demo webapp.
  -
  - Request routing does NOT go through here: web.xml maps /* to
  - org.apache.cocoon.servletservice.DispatcherServlet, which dispatches to the
  - block servlets, and COCOON-2120 removed the previous root sitemap when samples
  - handling moved into the cocoon-welcome block.
  -
  - The file still has to exist, because cocoon-sitemap-impl unconditionally
  - registers a root TreeProcessor on context://sitemap.xmap
  - (META-INF/cocoon/avalon/cocoon-core-sitemap.xconf), and the Avalon bridge
  - instantiates it eagerly at startup. Without this file the Spring context fails
  - with "Cannot resolve context://sitemap.xmap" and the webapp never deploys.
  -->
<map:sitemap xmlns:map="http://apache.org/cocoon/sitemap/1.0">

  <map:pipelines>
    <map:pipeline>

      <!-- Anything reaching the root sitemap has bypassed the block dispatcher. -->
      <map:match pattern="**">
        <map:generate type="serverpages" src="context://not-found.xml"/>
        <map:serialize type="xml" status-code="404"/>
      </map:match>

    </map:pipeline>
  </map:pipelines>
</map:sitemap>
