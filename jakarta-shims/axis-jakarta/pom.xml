<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.cocoon</groupId>
    <artifactId>cocoon-jakarta-shims</artifactId>
    <version>2.3.1-workflow-jakarta-1-SNAPSHOT</version>
  </parent>

  <artifactId>axis-jakarta</artifactId>
  <packaging>jar</packaging>
  <name>Apache Axis 1.4 [jakarta]</name>

  <description>
    Apache Axis 1.4 with the javax.* to jakarta.* rename applied by Eclipse Transformer
    (servlet, mail, jms, activation, xml.soap). axis-1.4.jar contains only
    org.apache.axis classes, so transforming it introduces no split packages.

    Two APIs it depends on are deliberately NOT transformed and are taken from their
    real Jakarta releases instead, so that no transformed copy of a spec API ends up
    on the classpath next to the genuine one:

      - SAAJ: axis-saaj-1.4 is the javax.xml.soap API. Replaced by
        jakarta.xml.soap-api, which is that API under the renamed packages.
      - JAX-RPC: axis-jaxrpc-1.4 is the javax.xml.rpc API. Replaced by
        jakarta.xml.rpc-api, which renamed only the Maven coordinates -- JAX-RPC
        was dropped from Jakarta EE and never got a package rename, so its classes
        are still javax.xml.rpc. That is why javax.xml.rpc references survive in
        the transformed jar, and why they are correct.
  </description>

  <build>
    <plugins>
      <!-- No sources here: the artifact is produced entirely by the transformer. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.eclipse.transformer</groupId>
        <artifactId>transformer-maven-plugin</artifactId>
        <version>${transformer.plugin.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <id>transform</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <!--
                jakartaDefaults is OFF by default: without it the plugin runs,
                reports success, and copies the jar through unchanged.
              -->
              <rules>
                <jakartaDefaults>true</jakartaDefaults>
              </rules>
              <artifact>
                <groupId>org.apache.axis</groupId>
                <artifactId>axis</artifactId>
                <version>${axis.version}</version>
              </artifact>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.apache.cocoon</groupId>
      <artifactId>jaxrpc-api-jakarta</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.xml.soap</groupId>
      <artifactId>jakarta.xml.soap-api</artifactId>
      <version>${jakarta.xml.soap.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.activation</groupId>
      <artifactId>jakarta.activation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-discovery</groupId>
      <artifactId>commons-discovery</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
    </dependency>
    <dependency>
      <groupId>axis</groupId>
      <artifactId>axis-wsdl4j</artifactId>
    </dependency>
  </dependencies>

</project>
