<!-- Version: $Id$ -->
<xweb xpath="/*" insert-before="*[last() and local-name() = 'filter']">
  <!--+
      | Spring Security's filter chain.
      |
      | This replaces Acegi's FilterToBeanProxy, which took the target bean's class as an
      | init-param. DelegatingFilterProxy instead looks the bean up by the filter's own name,
      | so the name below is not decorative: it must be springSecurityFilterChain, which is
      | what the security namespace registers.
      +-->
  <filter>
    <description>Spring Security Filter Chain Proxy</description>
    <display-name>Spring Security Filter Chain Proxy</display-name>
    <filter-name>springSecurityFilterChain</filter-name>
    <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
  </filter>

  <!--+
      | Map filter for Spring Security handling
      +-->
  <filter-mapping>
    <filter-name>springSecurityFilterChain</filter-name>
    <servlet-name>DispatcherServlet</servlet-name>
  </filter-mapping>
</xweb>
