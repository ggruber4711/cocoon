<!--+
    | Spring Security configuration for this sample.
    |
    | This was an Acegi Security 1.0 configuration. Acegi could not simply be version-bumped:
    | it was renamed to Spring Security at 2.0, its last release (1.0.7) predates Spring 3 and
    | is a javax.servlet library, so no release of it can run on Jakarta EE 10. The
    | configuration was rewritten rather than ported.
    |
    | It is also much shorter than what it replaces. Acegi required each filter in the chain to
    | be declared as a bean and then listed, by name, in a whitespace-sensitive string; the
    | security namespace builds that chain itself. The behaviour intended by the original is
    | preserved: anonymous access to the welcome, login and access-denied pages, ROLE_SUPERVISOR
    | for the supervisor page, ROLE_USER for everything else.
    |
    | Version: $Id$
    +-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:security="http://www.springframework.org/schema/security"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/security
                           http://www.springframework.org/schema/security/spring-security.xsd">

  <!-- Logs authentication successes and failures; the equivalent of Acegi's LoggerListener. -->
  <bean id="loggerListener"
        class="org.springframework.security.authentication.event.LoggerListener"/>

  <!--+
      | Builds the springSecurityFilterChain bean that the DelegatingFilterProxy in web.xml
      | delegates to. Rules are matched top down, so the most specific must come first.
      +-->
  <security:http auto-config="false" entry-point-ref="loginEntryPoint">
    <security:intercept-url pattern="/cocoon-springsecurity-sample/welcome" access="permitAll"/>
    <security:intercept-url pattern="/cocoon-springsecurity-sample/login" access="permitAll"/>
    <security:intercept-url pattern="/cocoon-springsecurity-sample/accessDenied" access="permitAll"/>
    <security:intercept-url pattern="/cocoon-springsecurity-sample/supervisor"
                            access="hasRole('SUPERVISOR')"/>
    <security:intercept-url pattern="/cocoon-springsecurity-sample/**" access="hasRole('USER')"/>

    <security:form-login login-page="/cocoon-springsecurity-sample/login"
                         login-processing-url="/cocoon-springsecurity-sample/security_check"
                         default-target-url="/cocoon-springsecurity-sample/welcome"
                         authentication-failure-url="/cocoon-springsecurity-sample/login?login_error=1"/>

    <security:logout logout-url="/cocoon-springsecurity-sample/logout"
                     logout-success-url="/cocoon-springsecurity-sample/welcome"/>

    <security:access-denied-handler error-page="/cocoon-springsecurity-sample/accessDenied"/>

    <security:anonymous username="anonymousUser" granted-authority="ROLE_ANONYMOUS"/>

    <!-- The sample posts a plain form; there is no CSRF token in login.xml. -->
    <security:csrf disabled="true"/>
  </security:http>

  <bean id="loginEntryPoint"
        class="org.springframework.security.web.authentication.LoginUrlAuthenticationEntryPoint">
    <constructor-arg value="/cocoon-springsecurity-sample/login"/>
    <property name="forceHttps" value="false"/>
  </bean>

  <!--+
      | The in-memory users Acegi declared through InMemoryDaoImpl's userMap string.
      |
      | The {noop} prefix is required: Spring Security 5 made PasswordEncoder mandatory and
      | rejects a bare password at authentication time with "There is no PasswordEncoder mapped
      | for the id null". {noop} selects the no-op encoder, which is what the original did
      | implicitly. It is acceptable here only because this is a demo with fixed credentials.
      +-->
  <security:authentication-manager>
    <security:authentication-provider>
      <security:user-service>
        <security:user name="cocoon" password="{noop}cocoon"
                       authorities="ROLE_USER,ROLE_SUPERVISOR"/>
        <security:user name="guest" password="{noop}guest" authorities="ROLE_USER"/>
        <security:user name="other" password="{noop}other" authorities="ROLE_OTHER"/>
      </security:user-service>
    </security:authentication-provider>
  </security:authentication-manager>

</beans>
