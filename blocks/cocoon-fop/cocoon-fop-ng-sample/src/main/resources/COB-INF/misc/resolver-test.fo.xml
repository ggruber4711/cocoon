<!--+
    | Exercises FOPNGSerializer's ResourceResolver.
    |
    | The image below is addressed with "blockcontext:", a Cocoon protocol. FOP's own URI
    | handling cannot fetch it; resolving it requires going through Cocoon's SourceResolver,
    | which is what CocoonResourceResolver exists to do. If that adapter is broken, or is not
    | wired into the FopFactory, FOP logs an event and renders the page without the image.
    | The response is then still a valid 200 PDF, just one with no image in it, so
    | FOPNGResolverTest asserts on the presence of an image XObject rather than on the
    | status code.
    +-->
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
  <fo:layout-master-set>
    <fo:simple-page-master master-name="main"
                           page-height="12cm" page-width="20cm"
                           margin-top="2cm" margin-bottom="2cm"
                           margin-left="2cm" margin-right="2cm">
      <fo:region-body margin-top="0cm"/>
    </fo:simple-page-master>
  </fo:layout-master-set>

  <fo:page-sequence master-reference="main">
    <fo:flow flow-name="xsl-region-body">
      <fo:block font-size="14pt">Resource resolver test</fo:block>
      <fo:block>
        <fo:external-graphic src="blockcontext:/cocoon-samples-style-default/resources/images/cocoon.gif"/>
      </fo:block>
    </fo:flow>
  </fo:page-sequence>
</fo:root>
